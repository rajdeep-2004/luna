# Copy to server/.env and fill in. Never commit .env.
NODE_ENV=development
PORT=8080
# MongoDB Atlas connection string (database: luna_dev locally, luna_prod on Render)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/luna_dev?retryWrites=true&w=majority
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated origins allowed by CORS (only Expo web needs this)
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=info
